model PainelGestaoOrcamentaria
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["dCalendario","dPlanoContas","dCentroCusto","fLancamentosRealizados","fOrcamento","fVendas","ParamPreco","ParamCusto","ParamVolume","_Medidas"]

annotation PBI_ProTooling = ["DevMode"]

ref table dCalendario
ref table dPlanoContas
ref table dCentroCusto
ref table fLancamentosRealizados
ref table fOrcamento
ref table fVendas
ref table ParamPreco
ref table ParamCusto
ref table ParamVolume
ref table _Medidas

