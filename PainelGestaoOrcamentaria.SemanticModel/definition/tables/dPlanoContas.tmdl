	partition dPlanoContas = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents("D:\FATEC\projetos\PBI\Base_PowerBI_Gestao_Orcamentaria.xlsx"), null, true),
				    Sheet = Source{[Item="dPlanoContas",Kind="Sheet"]}[Data],
				    Headers = if Text.StartsWith(Table.ColumnNames(Sheet){0}, "Column")
				        then Table.PromoteHeaders(Sheet, [PromoteAllScalars = true])
				        else Sheet,
				    Tipos = Table.TransformColumnTypes(Headers, {{"ContaID", Int64.Type},{"Conta", type text},{"Categoria", type text}})
				in
				    Tipos

		annotation PBI_NavigationStepName = Navigation

		annotation PBI_ResultType = Table

