table fVendas
	lineageTag: 71c094e9-c355-4132-87b5-2e1b52370c68

	column Data
		dataType: dateTime
		formatString: dd/MM/yyyy
		lineageTag: 70323503-083b-4315-9a59-c77aafbb286c
		summarizeBy: none
		sourceColumn: Data

		annotation SummarizationSetBy = Automatic

	column Unidades
		dataType: int64
		lineageTag: 9926237b-4c2b-4266-813b-d0b4cd9a2a21
		summarizeBy: sum
		sourceColumn: Unidades

		annotation SummarizationSetBy = Automatic

	column PrecoUnitario
		dataType: double
		lineageTag: 4cce5143-7010-4881-9345-07954777403a
		summarizeBy: sum
		sourceColumn: PrecoUnitario

		annotation SummarizationSetBy = Automatic

	column CustoVariavelUnitario
		dataType: double
		lineageTag: b83872e9-23bd-4081-b745-d5a4abaa5c5e
		summarizeBy: sum
		sourceColumn: CustoVariavelUnitario

		annotation SummarizationSetBy = Automatic

	partition fVendas = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents("D:\FATEC\projetos\PBI\Base_PowerBI_Gestao_Orcamentaria.xlsx"), null, true),
				    Sheet = Source{[Item="fVendas",Kind="Sheet"]}[Data],
				    Headers = if Text.StartsWith(Table.ColumnNames(Sheet){0}, "Column")
				        then Table.PromoteHeaders(Sheet, [PromoteAllScalars = true])
				        else Sheet,
				    Tipos = Table.TransformColumnTypes(Headers, {{"Data", type date},{"Unidades", Int64.Type},{"PrecoUnitario", type number},{"CustoVariavelUnitario", type number}})
				in
				    Tipos

		annotation PBI_NavigationStepName = Navigation

		annotation PBI_ResultType = Table

